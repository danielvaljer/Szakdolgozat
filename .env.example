# Ezt a fájlt másold .env.local néven és töltsd ki a saját értékeiddel.
# A .env.local NINCS a verziókövetésben – kulcs soha nem kerül commitba.

# Adatbázis (lokális Supabase: `supabase start` → a kimenet mutatja az értékeket)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase (felhős projekt: Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-kulcs>
SUPABASE_SERVICE_ROLE_KEY=<service-role-kulcs>

# Gépi tanulás szolgáltatás (2026. decembertől)
ML_SERVICE_URL=http://127.0.0.1:8000
